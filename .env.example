# Discord Developer Portal > Bot
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional: Specific Server ID for instant slash command updates in test server
DISCORD_GUILD_ID=your_server_id_here

# TMDB API Read Access Token (Bearer token) or API key from https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=your_tmdb_read_access_token_here
TMDB_API_KEY=your_tmdb_api_key_here

# Optional OMDb API Key from https://www.omdbapi.com/apikey.aspx (for IMDb ratings)
OMDB_API_KEY=

# Country code for streaming providers, e.g. IN, US, GB (default: IN)
WATCH_REGION=IN
